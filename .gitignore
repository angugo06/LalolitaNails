# Read about how to use .gitignore: https://help.github.com/articles/ignoring-files

# Dependencies
node_modules/

# Build output (regenerated with `npm run build`)
dist/
.cache/

# Secrets & local environment — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Logs & debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors / IDEs
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Local scratch (screenshots, temp checks)
/_shot-*.png
/tmp/
